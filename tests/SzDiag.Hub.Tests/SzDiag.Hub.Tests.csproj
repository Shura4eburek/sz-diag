    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SzDiag.Hub\SzDiag.Hub.csproj" />
    <ProjectReference Include="..\..\src\SzDiag.Contracts\SzDiag.Contracts.csproj" />
    <!-- Только ради сквозного теста забора файлов (PullEndToEndTests): в нём участвует
         НАСТОЯЩИЙ обработчик агента, иначе тест проверял бы копию логики, а не её саму. -->
    <ProjectReference Include="..\..\src\SzDiag.Agent\SzDiag.Agent.csproj" />
  </ItemGroup>

