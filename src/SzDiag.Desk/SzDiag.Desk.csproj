<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Лёгкий CLAUDE.md сессий заявок: Desk рендерит его в каталог сессий при старте. -->
    <EmbeddedResource Include="Assets\sz-session-CLAUDE.md" LogicalName="sz-session-CLAUDE.md" />
    <!-- Шрифты дизайн-системы Shirabe внутри exe: бокс может быть без интернета и без них в системе. -->
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SzDiag.Contracts\SzDiag.Contracts.csproj" />
    <ProjectReference Include="..\SzDiag.HubClient\SzDiag.HubClient.csproj" />
    <ProjectReference Include="..\SzDiag.Kb\SzDiag.Kb.csproj" />
    <ProjectReference Include="..\SzDiag.Claude\SzDiag.Claude.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Avalonia держим на 11.x, как в спеке: 12.x — мажор с ломающими изменениями API окна. -->
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Markdown.Avalonia.Tight" Version="11.0.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Локальный адрес/токен hub для запуска из исходников: в bin — да, в dist (publish) — нет,
         иначе он перекрыл бы конфиг, который пишет build-dist. -->
    <None Update="appsettings.local.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Skia/HarfBuzz — нативные dll; без этого single-file публикация кладёт их рядом россыпью -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

</Project>
