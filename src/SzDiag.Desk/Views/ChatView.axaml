<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SzDiag.Desk.ViewModels"
             xmlns:v="using:SzDiag.Desk.Views"
             xmlns:md="https://github.com/whistyun/Markdown.Avalonia.Tight"
             xmlns:ctxt="clr-namespace:ColorTextBlock.Avalonia;assembly=ColorTextBlock.Avalonia"
             x:Class="SzDiag.Desk.Views.ChatView"
             x:DataType="vm:ChatViewModel">
  <UserControl.Styles>
    <!-- Markdown ответа (ChatMessage): заголовки любого уровня — heading, код — моно на bg.code. -->
    <Style Selector="md|MarkdownScrollViewer ctxt|CTextBlock.Heading1, md|MarkdownScrollViewer ctxt|CTextBlock.Heading2, md|MarkdownScrollViewer ctxt|CTextBlock.Heading3, md|MarkdownScrollViewer ctxt|CTextBlock.Heading4">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
    </Style>
    <Style Selector="md|MarkdownScrollViewer Border.CodeBlock">
      <Setter Property="Background" Value="{StaticResource Bg.Code}" />
      <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}" />
    </Style>
    <Style Selector="md|MarkdownScrollViewer TextBlock.CodeBlock">
      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="md|MarkdownScrollViewer ctxt|CCode">
      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
      <Setter Property="Background" Value="{StaticResource Bg.Surface2}" />
    </Style>
    <Style Selector="md|MarkdownScrollViewer ctxt|CHyperlink">
      <Setter Property="Foreground" Value="{StaticResource Accent.Text}" />
    </Style>
    <!-- Строка ToolCall: без фона, hover — bg.hover, развёрнутая — bg.pressed. -->
    <Style Selector="Button.toolrow.open">
      <Setter Property="Background" Value="{StaticResource Bg.Pressed}" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <!-- Composer: очередь над полем, рамка border.control (в фокусе — border.focus), Стоп и Отправить. -->
    <Border DockPanel.Dock="Bottom" Padding="12,8,12,12">
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasQueue}">
          <Path Classes="icon sm" Data="{StaticResource Icon.Clock}" Stroke="{StaticResource Text.Secondary}" />
          <TextBlock Classes="small secondary" VerticalAlignment="Center"
                     Text="{Binding Queued, StringFormat='В очереди: {0} — уйдут после текущего хода'}" />
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBox x:Name="ChatInput" Text="{Binding Draft}" AcceptsReturn="True" TextWrapping="Wrap"
                   MaxHeight="160" MinHeight="36" CornerRadius="{StaticResource Radius.Lg}" Padding="10,8"
                   Watermark="Сообщение для Claude — Enter отправить, Shift+Enter перенос строки" />
          <Button Grid.Column="1" Classes="stop" Margin="8,0,0,0" VerticalAlignment="Bottom"
                  ToolTip.Tip="Остановить ход (неотправленное вернётся в поле ввода)"
                  Command="{Binding StopCommand}" IsVisible="{Binding CanStop}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Classes="icon fill" Data="{StaticResource Icon.Stop}" Stroke="{StaticResource Status.Error}" />
              <TextBlock Text="Стоп" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Classes="primary" Margin="8,0,0,0" VerticalAlignment="Bottom"
                  Command="{Binding SendCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Classes="icon" Data="{StaticResource Icon.Send}" Stroke="{StaticResource Text.OnAccent}" />
              <TextBlock Text="Отправить" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
      </StackPanel>
    </Border>
    <ScrollViewer x:Name="FeedScroll">
      <StackPanel>
      <ItemsControl ItemsSource="{Binding Items}" Margin="20,16,20,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="10" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.DataTemplates>
          <!-- Реплика оператора: плашка bg.surface-2 справа, не акцентной заливкой. -->
          <DataTemplate DataType="vm:UserFeedItem">
            <Border HorizontalAlignment="Right" MaxWidth="560" Background="{StaticResource Bg.Surface2}"
                    CornerRadius="{StaticResource Radius.Lg}" Padding="12,8">
              <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" Classes="body" />
            </Border>
          </DataTemplate>
          <DataTemplate DataType="vm:AssistantFeedItem">
            <md:MarkdownScrollViewer Markdown="{Binding Text}" />
          </DataTemplate>
          <!-- ToolCall: шеврон · иконка · имя · аргументы … исход · длительность; тело — на bg.code. -->
          <DataTemplate DataType="vm:ToolFeedItem">
            <StackPanel Spacing="2">
              <Button Classes="row toolrow" Classes.open="{Binding IsExpanded}" Command="{Binding ToggleCommand}"
                      CornerRadius="{StaticResource Radius.Sm}" ToolTip.Tip="{Binding Header}">
                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                  <Path Classes="icon sm" Data="{Binding IsExpanded, Converter={x:Static v:Converters.BoolToChevron}}"
                        Stroke="{StaticResource Text.Secondary}" />
                  <Path Grid.Column="1" Classes="icon sm" Data="{StaticResource Icon.Tool}" Margin="2,0,6,0"
                        Stroke="{StaticResource Text.Secondary}" />
                  <TextBlock Grid.Column="2" Text="{Binding Name}" Classes="code" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding Summary}" Classes="code secondary" Margin="8,0,0,0"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <Path Grid.Column="4" Classes="icon sm" Margin="8,0,0,0"
                        Data="{Binding Status, Converter={x:Static v:Converters.ToolStatusToIcon}}"
                        Stroke="{Binding Status, Converter={x:Static v:Converters.ToolStatusToBrush}}"
                        ToolTip.Tip="{Binding Status, Converter={x:Static v:Converters.ToolStatusToText}}" />
                  <TextBlock Grid.Column="5" Text="{Binding Meta}" Classes="code-small secondary" Margin="6,0,0,0"
                             VerticalAlignment="Center" />
                </Grid>
              </Button>
              <Border Classes="code" IsVisible="{Binding IsExpanded}" Margin="22,0,0,0">
                <SelectableTextBlock Text="{Binding Output}" TextWrapping="Wrap" Classes="code" />
              </Border>
            </StackPanel>
          </DataTemplate>
          <!-- ApprovalCard: рамка status.approval, щит, команда дословно на bg.code, Разрешить → Запретить. -->
          <DataTemplate DataType="vm:PermissionFeedItem">
            <Border Classes="card approval" Background="{StaticResource Status.ApprovalSubtle}">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Path Classes="icon" Data="{StaticResource Icon.Shield}" Stroke="{StaticResource Status.Approval}" />
                  <TextBlock Text="{Binding Title}" Classes="title" VerticalAlignment="Center" />
                  <TextBlock Text="Ждёт подтверждения" Classes="small warning" VerticalAlignment="Center"
                             IsVisible="{Binding IsPending}" />
                </StackPanel>
                <Border Classes="code">
                  <ScrollViewer MaxHeight="240">
                    <SelectableTextBlock Text="{Binding Details}" Classes="code" TextWrapping="Wrap" />
                  </ScrollViewer>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsPending}">
                  <Button Content="Разрешить" Classes="primary" Command="{Binding AllowCommand}" />
                  <Button Content="Запретить" Command="{Binding DenyCommand}" />
                </StackPanel>
                <TextBlock Classes="small secondary" Text="{Binding ResultText}" IsVisible="{Binding !IsPending}" />
              </StackPanel>
            </Border>
          </DataTemplate>
          <!-- Вопрос соседней сессии (QuestionCard): иконка чата, акцентный текст — второго акцента нет. -->
          <DataTemplate DataType="vm:PeerFeedItem">
            <Border Classes="card" HorizontalAlignment="Left" MaxWidth="640">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Classes="icon" Data="{StaticResource Icon.Chat}" Stroke="{StaticResource Accent.Text}"
                      VerticalAlignment="Top" />
                <SelectableTextBlock Text="{Binding Title}" Classes="body" TextWrapping="Wrap" MaxWidth="590" />
              </StackPanel>
            </Border>
          </DataTemplate>
          <DataTemplate DataType="vm:NoteFeedItem">
            <TextBlock Text="{Binding Text}" Classes="small secondary" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" />
          </DataTemplate>
          <DataTemplate DataType="vm:CrashFeedItem">
            <Border Classes="card error" Background="{StaticResource Status.ErrorSubtle}">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Path Classes="icon" Data="{StaticResource Icon.Warn}" Stroke="{StaticResource Status.Error}" />
                  <TextBlock Text="{Binding Title}" Classes="title error" VerticalAlignment="Center" />
                </StackPanel>
                <Border Classes="code">
                  <SelectableTextBlock Text="{Binding Details}" Classes="code" TextWrapping="Wrap" />
                </Border>
                <Button Content="Перезапустить (--resume)" Command="{Binding RestartCommand}" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
          </DataTemplate>
          <DataTemplate DataType="vm:RawFeedItem">
            <Expander Header="{Binding Title}">
              <SelectableTextBlock Text="{Binding Raw}" Classes="code-small" TextWrapping="Wrap" />
            </Expander>
          </DataTemplate>
        </ItemsControl.DataTemplates>
      </ItemsControl>
      <!-- Идёт ход: видно в ленте, а не только словом в шапке (бэклог п.267). -->
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="20,10,20,14" IsVisible="{Binding IsBusy}">
        <v:StatusDot Kind="Run" Live="True" />
        <TextBlock Text="{Binding BusyText}" Classes="small accent" VerticalAlignment="Center" />
      </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
