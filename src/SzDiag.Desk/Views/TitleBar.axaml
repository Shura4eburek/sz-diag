<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SzDiag.Desk.Views.TitleBar"
             Height="{StaticResource Size.Toolbar}" Background="{StaticResource Bg.Base}">
  <!-- Тулбар на раме: пустое место — зона перетаскивания (двойной клик — развернуть/восстановить),
       справа кнопки окна 46×40. -->
  <Grid ColumnDefinitions="*,Auto">
    <Border x:Name="DragArea" Background="Transparent">
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="14,0" VerticalAlignment="Center">
        <Path Classes="icon" Data="{StaticResource Icon.Pulse}" Stroke="{StaticResource Accent.Text}" />
        <TextBlock Text="SzDiag" Classes="body-medium" VerticalAlignment="Center" />
      </StackPanel>
    </Border>
    <StackPanel Grid.Column="1" Orientation="Horizontal">
      <Button x:Name="MinButton" Classes="caption" ToolTip.Tip="Свернуть">
        <Path Classes="icon" Data="{StaticResource Icon.Min}" />
      </Button>
      <Button x:Name="MaxButton" Classes="caption" ToolTip.Tip="Развернуть">
        <Path x:Name="MaxIcon" Classes="icon" Data="{StaticResource Icon.Max}" />
      </Button>
      <Button x:Name="CloseButton" Classes="caption close" ToolTip.Tip="Закрыть">
        <Path Classes="icon" Data="{StaticResource Icon.X}" />
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
