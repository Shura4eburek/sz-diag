<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SzDiag.Desk.ViewModels"
             xmlns:v="using:SzDiag.Desk.Views"
             x:Class="SzDiag.Desk.Views.SzListView"
             x:DataType="vm:MainViewModel">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Classes="section" Margin="14,12,14,6"
               Text="{Binding Items.Count, StringFormat='Заявки · {0}'}" />
    <!-- СЗ вне списка hub: закрытые (разговор остался, продолжение — через resume) и заведённые без агента. -->
    <StackPanel DockPanel.Dock="Bottom" IsVisible="{Binding HasArchived}" Margin="0,0,0,8">
      <Border BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,0" Margin="0,4,0,0" />
      <TextBlock Classes="section" Margin="14,10,14,6" Text="Без агента · архив" />
      <ListBox ItemsSource="{Binding Archived}" SelectedItem="{Binding SelectedArchived}"
               Margin="6,0" MaxHeight="220">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ArchivedItemViewModel">
            <StackPanel>
              <TextBlock Text="{Binding Key}" Classes="body-medium secondary" />
              <TextBlock Text="{Binding Subtitle}" Classes="small secondary" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>
    <ListBox x:Name="List" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Margin="6,0">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:SzItemViewModel">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <v:StatusDot Margin="0,4,10,0" VerticalAlignment="Top"
                         Kind="{Binding Liveness, Converter={x:Static v:Converters.LivenessToDot}}"
                         ToolTip.Tip="{Binding Liveness, Converter={x:Static v:Converters.LivenessToText}}" />
            <StackPanel Grid.Column="1">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding Sz}" Classes="body-medium" />
                <!-- Бейджи: иконка + число/номер, смысл — словом в подсказке. -->
                <Border Classes="badge" IsVisible="{Binding HasReboots}"
                        ToolTip.Tip="{Binding RebootCount, StringFormat='Вырубонов за заявку: {0}'}">
                  <StackPanel Orientation="Horizontal" Spacing="2">
                    <Path Classes="icon sm" Data="{StaticResource Icon.Bolt}" Stroke="{StaticResource Status.Error}" />
                    <TextBlock Text="{Binding RebootCount}" Classes="caption error" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
                <Border x:Name="FrozenBadge" Classes="badge" IsVisible="{Binding IsFrozen}"
                        ToolTip.Tip="Windows Update заморожен — не забудь unfreeze до close">
                  <Path Classes="icon sm" Data="{StaticResource Icon.Snow}" Stroke="{StaticResource Accent.Text}" />
                </Border>
              </StackPanel>
              <TextBlock Text="{Binding Subtitle}" Classes="small secondary" TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding Subtitle}" />
              <TextBlock Text="{Binding HwLine}" Classes="small secondary" TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding HwLine}" IsVisible="{Binding HasHwLine}" />
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0"
                          IsVisible="{Binding HasSimilar}">
                <TextBlock Text="{Binding SimilarText}" Classes="caption accent" ToolTip.Tip="{Binding SimilarTip}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0" IsVisible="{Binding HasPeer}"
                          ToolTip.Tip="Сессии переписываются (ask_peer)">
                <Path Classes="icon sm" Data="{StaticResource Icon.Chat}" Stroke="{StaticResource Accent.Text}" />
                <TextBlock Text="{Binding PeerText}" Classes="caption accent" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
            <!-- Сессия — иконкой чата цвета статуса: точки слева — только живость машины. -->
            <Path Grid.Column="2" Classes="icon sm" Data="{StaticResource Icon.Chat}" Margin="8,2,0,0"
                  VerticalAlignment="Top" IsVisible="{Binding HasSession}"
                  Classes.live="{Binding SessionState, Converter={x:Static v:Converters.SessionStateIsLive}}"
                  Stroke="{Binding SessionState, Converter={x:Static v:Converters.SessionStateToBrush}}"
                  ToolTip.Tip="{Binding SessionState, Converter={x:Static v:Converters.SessionStateToText}}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
