<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SzDiag.Desk.ViewModels.Inspector"
             x:Class="SzDiag.Desk.Views.Inspector.ActionsView"
             x:DataType="vm:ActionsViewModel">
  <ScrollViewer>
    <StackPanel Spacing="12">
      <!-- Подтверждение разрушительного действия: одно на всю вкладку, поверх кнопок. -->
      <Border Classes="card approval" Background="{StaticResource Status.ApprovalSubtle}"
              IsVisible="{Binding PendingConfirm, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Classes="icon" Data="{StaticResource Icon.Warn}" Stroke="{StaticResource Status.Approval}" VerticalAlignment="Top" />
            <TextBlock Text="{Binding PendingConfirm}" Classes="body" TextWrapping="Wrap" MaxWidth="240" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Да, выполнить" Classes="danger" Command="{Binding ConfirmCommand}" />
            <Button Content="Отмена" Command="{Binding CancelConfirmCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <StackPanel Spacing="12" IsEnabled="{Binding IsIdle}">
        <StackPanel Spacing="6">
          <TextBlock Classes="section" Text="Диагностика" />
          <TextBox Text="{Binding DiagSections}" Watermark="Секции через пробел (пусто — все)" />
          <Button Content="diag run" Command="{Binding DiagRunCommand}" />
        </StackPanel>
        <StackPanel Spacing="6">
          <TextBlock Classes="section" Text="Прогон" />
          <TextBox Text="{Binding TestConfig}" Watermark="Метка конфигурации (обязательно): EXPO 6000 / сток" />
          <TextBox Text="{Binding TestFilter}" Watermark="Фильтр тестов (необязательно)" />
          <Button Content="test run" Command="{Binding TestRunCommand}" />
        </StackPanel>
        <StackPanel Spacing="6">
          <TextBlock Classes="section" Text="Windows Update" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Command="{Binding FreezeCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Classes="icon" Data="{StaticResource Icon.Snow}" />
                <TextBlock Text="freeze" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Content="unfreeze…" Command="{Binding UnfreezeCommand}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Spacing="6">
          <TextBlock Classes="section" Text="Заметка в журнал" />
          <TextBox Text="{Binding NoteText}" Watermark="Свап БП, правка BIOS, осмотр…" AcceptsReturn="False" />
          <Button Content="Записать" Command="{Binding NoteCommand}" />
        </StackPanel>
        <StackPanel Spacing="6">
          <TextBlock Classes="section" Text="Заявка" />
          <Button Content="sz fetch (данные из ERP, несколько минут)" Command="{Binding SzFetchCommand}" />
          <!-- Разрушительное — danger: отличается и цветом, и подписью «close». -->
          <Button Content="close — закрыть заявку…" Classes="danger" Command="{Binding CloseCommand}" />
          <TextBox Text="{Binding CloseReason}" Watermark="Причина для close --force" />
          <Button Content="close --force — закрыть в обход проверок…" Classes="danger" Command="{Binding CloseForceCommand}" />
        </StackPanel>
      </StackPanel>

      <Button Classes="stop" Command="{Binding CancelCommand}" IsVisible="{Binding Running}" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Classes="icon fill" Data="{StaticResource Icon.Stop}" Stroke="{StaticResource Status.Error}" />
          <TextBlock Text="Прервать команду" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Border Classes="code" IsVisible="{Binding Log, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <SelectableTextBlock Text="{Binding Log}" Classes="code-small" TextWrapping="Wrap" />
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
