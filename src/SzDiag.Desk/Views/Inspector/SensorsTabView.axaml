<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SzDiag.Desk.ViewModels.Inspector"
             x:Class="SzDiag.Desk.Views.Inspector.SensorsTabView"
             x:DataType="vm:SensorsTabViewModel">
  <StackPanel Spacing="6">
    <TextBlock Text="{Binding Status}" Classes="small secondary" TextWrapping="Wrap" />
    <SelectableTextBlock Text="{Binding StartHint}" IsVisible="{Binding NotWriting}"
                         Classes="code-small secondary" TextWrapping="Wrap" />
    <StackPanel Spacing="3" IsVisible="{Binding HasData}">
      <TextBlock Text="{Binding CpuText}" Classes="code" />
      <TextBlock Text="{Binding GpuText}" Classes="code" />
      <TextBlock Text="{Binding PowerText}" Classes="code-small secondary" />
      <TextBlock Text="{Binding VoltText}" Classes="code-small secondary" />
    </StackPanel>
    <!-- Пустой график не рисуется (спека): ломаная из одной точки ничего не говорит. -->
    <StackPanel Spacing="2" IsVisible="{Binding HasCpuLine}">
      <TextBlock Classes="section" Text="Температура CPU" />
      <Border Classes="code" Padding="6" Width="276" HorizontalAlignment="Left">
        <Polyline Points="{Binding CpuTempLine}" Stroke="{StaticResource Status.Warning}" StrokeThickness="1.4" Height="56" Width="260" />
      </Border>
    </StackPanel>
    <StackPanel Spacing="2" IsVisible="{Binding HasGpuLine}">
      <TextBlock Classes="section" Text="Температура GPU" />
      <Border Classes="code" Padding="6" Width="276" HorizontalAlignment="Left">
        <Polyline Points="{Binding GpuTempLine}" Stroke="{StaticResource Accent.Text}" StrokeThickness="1.4" Height="56" Width="260" />
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
