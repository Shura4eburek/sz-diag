<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:SzDiag.Desk.Views"
        xmlns:vm="using:SzDiag.Desk.ViewModels"
        x:Class="SzDiag.Desk.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="SzDiag" Width="1280" Height="780" MinWidth="900" MinHeight="520"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="40">
  <!-- Окно по карточке MainWindow Shirabe: рама bg.base, тулбар 40 и статус-бар 24 на раме,
       между ними острова (заявки 268 · чат · инспектор 308) с зазором 6. Отступ Root — под
       OffScreenMargin: развёрнутое окно без рамки Windows выдвигает за край экрана. -->
  <DockPanel x:Name="Root">
    <v:TitleBar x:Name="TitleBar" DockPanel.Dock="Top" />
    <Border x:Name="StatusPane" DockPanel.Dock="Bottom" Height="{StaticResource Size.Statusbar}">
      <v:StatusBarView DataContext="{Binding Status}" />
    </Border>
    <Grid ColumnDefinitions="268,*,Auto" Margin="6,0,6,0">
      <Border x:Name="LeftPane" Classes="island">
        <v:SzListView />
      </Border>
      <Border Grid.Column="1" Classes="island" Margin="6,0,0,0">
        <DockPanel x:Name="CenterPane">
          <!-- Шапка чата: СЗ · профиль · состояние словом и знаком; справа терминал и инспектор. -->
          <Border DockPanel.Dock="Top" Height="{StaticResource Size.Toolbar}" Padding="12,0,6,0"
                  BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Classes="title" VerticalAlignment="Center" />
                <Border Classes="badge"
                        IsVisible="{Binding ActiveChat.Profile, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
                  <TextBlock Text="{Binding ActiveChat.Profile, FallbackValue=''}" Classes="caption secondary" />
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            IsVisible="{Binding ActiveChat, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <v:StatusDot Kind="{Binding ActiveChat.State, Converter={x:Static v:Converters.SessionStateToDot}, FallbackValue={x:Static v:DotKind.Done}}"
                               Live="{Binding ActiveChat.State, Converter={x:Static v:Converters.SessionStateIsLive}, FallbackValue=False}" />
                  <TextBlock Text="{Binding ActiveChat.StateText, FallbackValue=''}" Classes="small secondary"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </StackPanel>
              <Button x:Name="TerminalButton" Grid.Column="1" Classes="ghost sm" Margin="0,0,4,0"
                      ToolTip.Tip="claude --resume в Windows Terminal; процесс в Desk при этом останавливается"
                      Command="{Binding ActiveChat.OpenInTerminalCommand, FallbackValue={x:Null}}"
                      IsVisible="{Binding ActiveChat, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Classes="icon" Data="{StaticResource Icon.Terminal}" />
                  <TextBlock Text="Открыть в терминале" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <ToggleButton x:Name="InspectorToggle" Grid.Column="2" Classes="icon"
                            IsChecked="{Binding IsInspectorOpen}" ToolTip.Tip="Инспектор заявки">
                <Path Classes="icon" Data="{StaticResource Icon.Split}" />
              </ToggleButton>
            </Grid>
          </Border>
          <!-- Нижняя tool window: передачи push/pull, только пока они есть. -->
          <Border DockPanel.Dock="Bottom" IsVisible="{Binding HasTransfers}" MaxHeight="270"
                  BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,0">
            <v:TransfersView />
          </Border>
          <Panel>
            <!-- СЗ без агента (машина не грузится): номер руками — сессия ради разбора в kb. -->
            <StackPanel x:Name="OfflineSessionPanel" IsVisible="{Binding ShowPlaceholder}" Spacing="8"
                        HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
              <Path Classes="icon lg" Data="{StaticResource Icon.Log}" HorizontalAlignment="Center"
                    Stroke="{StaticResource Text.Disabled}" />
              <TextBlock Text="Выберите заявку слева" Classes="body-medium" HorizontalAlignment="Center" />
              <TextBlock Text="или начните сессию без агента — когда машина не грузится" Classes="small secondary"
                         HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                         IsVisible="{Binding HasProfiles}" MaxWidth="280" />
              <TextBox x:Name="OfflineSzBox" Text="{Binding OfflineSz}" Watermark="Номер СЗ, 6 цифр"
                       Width="230" MaxLength="6" HorizontalAlignment="Center" Margin="0,4,0,0"
                       Classes.error="{Binding OfflineSzError, Converter={x:Static ObjectConverters.IsNotNull}}"
                       IsVisible="{Binding HasProfiles}" />
              <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"
                          IsVisible="{Binding OfflineSzError, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Path Classes="icon sm" Data="{StaticResource Icon.Warn}" Stroke="{StaticResource Status.Error}" />
                <TextBlock Text="{Binding OfflineSzError}" Classes="small error" TextWrapping="Wrap" MaxWidth="250" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Profiles}" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel ItemSpacing="8" LineSpacing="8" HorizontalAlignment="Center" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Button Content="{Binding}" MinWidth="110" HorizontalContentAlignment="Center"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).StartOfflineSessionCommand}"
                            CommandParameter="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <!-- Кнопка на каждый найденный профиль Claude: профиль закрепляется за разговором. -->
            <StackPanel x:Name="StartSessionPanel" IsVisible="{Binding CanStartSession}" Spacing="8"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
              <Path Classes="icon lg" Data="{StaticResource Icon.Chat}" HorizontalAlignment="Center"
                    Stroke="{StaticResource Text.Disabled}" />
              <TextBlock Text="Сессии Claude ещё нет" Classes="body-medium" HorizontalAlignment="Center" />
              <TextBlock Text="Выберите профиль — он закрепится за заявкой" Classes="small secondary"
                         HorizontalAlignment="Center" />
              <ItemsControl ItemsSource="{Binding Profiles}" HorizontalAlignment="Center" Margin="0,4,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel ItemSpacing="8" LineSpacing="8" HorizontalAlignment="Center" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Button Content="{Binding}" MinWidth="110" HorizontalContentAlignment="Center"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).StartSessionCommand}"
                            CommandParameter="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <!-- Видимость — на обёртке: у ChatView свой DataContext (модель чата), а решает модель окна. -->
            <Border IsVisible="{Binding ActiveChat, Converter={x:Static ObjectConverters.IsNotNull}}">
              <v:ChatView x:Name="ChatPane" DataContext="{Binding ActiveChat}" />
            </Border>
          </Panel>
        </DockPanel>
      </Border>
      <!-- В узком окне код окна переносит слот поверх чата (класс overlay — тень плавающего слоя). -->
      <Panel x:Name="InspectorSlot" Grid.Column="2" ZIndex="1">
        <Border x:Name="InspectorPane" Classes="island" Width="308" Margin="6,0,0,0"
                IsVisible="{Binding IsInspectorOpen}">
          <v:InspectorView />
        </Border>
      </Panel>
    </Grid>
  </DockPanel>
</Window>
