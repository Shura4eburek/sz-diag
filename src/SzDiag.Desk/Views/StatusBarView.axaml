<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SzDiag.Desk.ViewModels"
             xmlns:v="using:SzDiag.Desk.Views"
             x:Class="SzDiag.Desk.Views.StatusBarView"
             x:DataType="vm:StatusBarViewModel">
  <!-- StatusBar Shirabe: 24px на раме, small/text.secondary, состояние — знаком и словом. -->
  <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="14,0" VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal" Spacing="16">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <v:StatusDot Kind="Run" IsVisible="{Binding HubOk}" />
        <Path Classes="icon sm" Data="{StaticResource Icon.Warn}" Stroke="{StaticResource Status.Error}"
              IsVisible="{Binding !HubOk}" />
        <TextBlock Text="{Binding HubText}" Classes="small secondary" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Text="{Binding StaleText}" Classes="small warning" VerticalAlignment="Center"
                 IsVisible="{Binding StaleText, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>
    <!-- Пакет агента, бэкап kb, туннель — из /api/status; старый hub его не знает, тогда строки нет. -->
    <TextBlock Grid.Column="1" Text="{Binding DetailsText}" Classes="small" Margin="0,0,16,0"
               IsVisible="{Binding DetailsText, Converter={x:Static ObjectConverters.IsNotNull}}"
               Foreground="{Binding DetailsWarn, Converter={x:Static v:Converters.WarnToBrush}}" />
    <!-- Лимиты подписки по профилям Claude — из rate_limit_event каждого хода. -->
    <TextBlock Grid.Column="2" Text="{Binding LimitsText}" Classes="small" Margin="0,0,16,0"
               IsVisible="{Binding LimitsText, Converter={x:Static ObjectConverters.IsNotNull}}"
               Foreground="{Binding LimitsWarn, Converter={x:Static v:Converters.WarnToBrush}}"
               ToolTip.Tip="{Binding LimitsTip}" />
    <TextBlock Grid.Column="3" Text="{Binding TokensText}" Classes="small secondary"
               IsVisible="{Binding TokensText, Converter={x:Static ObjectConverters.IsNotNull}}" />
  </Grid>
</UserControl>
