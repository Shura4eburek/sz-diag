<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SzDiag.Desk.ViewModels"
             xmlns:v="using:SzDiag.Desk.Views"
             xmlns:iv="using:SzDiag.Desk.Views.Inspector"
             x:Class="SzDiag.Desk.Views.InspectorView"
             x:DataType="vm:MainViewModel">
  <UserControl.Styles>
    <!-- 7 вкладок в 308 px: переносятся во второй ряд, высота ряда — size.tab. -->
    <Style Selector="TabControl#InspectorTabs /template/ ItemsPresenter#PART_ItemsPresenter">
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="Padding" Value="7,0" />
    </Style>
  </UserControl.Styles>
  <Panel>
    <StackPanel IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNull}}" Spacing="6"
                HorizontalAlignment="Center" VerticalAlignment="Center">
      <Path Classes="icon lg" Data="{StaticResource Icon.Info}" Stroke="{StaticResource Text.Disabled}" HorizontalAlignment="Center" />
      <TextBlock Text="Заявка не выбрана" Classes="body-medium" HorizontalAlignment="Center" />
      <TextBlock Text="Инспектор покажет её состояние и действия" Classes="small secondary" HorizontalAlignment="Center" />
    </StackPanel>
    <TabControl x:Name="InspectorTabs" Padding="0" Margin="8,0,8,8"
                IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}"
                SelectedIndex="{Binding Inspector.SelectedIndex, FallbackValue=0}">
      <TabControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </TabControl.ItemsPanel>
      <TabItem Header="Обзор">
        <!-- Сводка: состояние и железо, вырубоны, последние сенсоры, передачи, быстрые действия.
             Сам «Обзор» exec к клиенту не шлёт: сенсоры — последние снятые вкладкой «Сенсоры». -->
        <ScrollViewer Margin="0,8,0,0">
          <StackPanel Spacing="8">
            <Border Classes="card">
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Selected.Sz}" Classes="title" />
                  <Border Grid.Column="1" Classes="badge" IsVisible="{Binding Selected.HasReboots, FallbackValue=False}"
                          ToolTip.Tip="Вырубонов за заявку">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                      <Path Classes="icon sm" Data="{StaticResource Icon.Bolt}" Stroke="{StaticResource Status.Error}" />
                      <TextBlock Text="{Binding Selected.RebootCount}" Classes="caption error" VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <v:StatusDot Kind="{Binding Selected.Liveness, Converter={x:Static v:Converters.LivenessToDot}, FallbackValue={x:Static v:DotKind.Done}}" />
                  <TextBlock Text="{Binding Selected.Liveness, Converter={x:Static v:Converters.LivenessToText}}" Classes="body"
                             Foreground="{Binding Selected.Liveness, Converter={x:Static v:Converters.LivenessToBrush}}" />
                </StackPanel>
                <TextBlock Text="{Binding Selected.HwLine}" Classes="body" TextWrapping="Wrap"
                           IsVisible="{Binding Selected.HasHwLine, FallbackValue=False}" />
                <TextBlock Classes="small secondary" TextWrapping="Wrap" Text="{Binding Selected.Info.Activity, StringFormat='Занята: {0}'}"
                           IsVisible="{Binding Selected.Info.Activity, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}" />
                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding Selected.IsFrozen, FallbackValue=False}">
                  <Path Classes="icon sm" Data="{StaticResource Icon.Snow}" Stroke="{StaticResource Status.Warning}" />
                  <TextBlock Classes="small warning" Text="Windows Update заморожен — не забудь unfreeze" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Classes="small secondary" Text="{Binding Selected.Info.Hostname, StringFormat='Хост: {0}'}" />
                <TextBlock Classes="small secondary" Text="{Binding Selected.Info.AccessMode, StringFormat='Доступ: {0}', TargetNullValue='Доступ: direct'}" />
                <TextBlock Classes="small secondary" Text="{Binding Selected.Info.LanIp, StringFormat='LAN: {0}'}"
                           IsVisible="{Binding Selected.Info.LanIp, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}" />
                <TextBlock Classes="small secondary" Text="{Binding Selected.BootTimeLocal, StringFormat='Загрузка: {0:dd.MM HH:mm}'}" />
                <TextBlock Classes="small secondary" Text="{Binding Selected.Info.LastRebootAt, StringFormat='Последний вырубон: {0:dd.MM HH:mm}'}"
                           IsVisible="{Binding Selected.HasReboots, FallbackValue=False}" />
              </StackPanel>
            </Border>
            <Border Classes="card" IsVisible="{Binding Inspector.Sensors.HasData, FallbackValue=False}">
              <StackPanel Spacing="3">
                <TextBlock Classes="section" Text="Сенсоры" />
                <TextBlock Text="{Binding Inspector.Sensors.CpuText}" Classes="code" />
                <TextBlock Text="{Binding Inspector.Sensors.GpuText}" Classes="code" />
                <TextBlock Text="{Binding Inspector.Sensors.Status}" Classes="small secondary" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding SelectedTransfers}" IsVisible="{Binding HasSelectedTransfers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TransferItemViewModel">
                  <Border Classes="card" Margin="0,0,0,6">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding Title}" Classes="code" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                      <TextBlock Text="{Binding Detail}" Classes="code-small secondary" />
                      <ProgressBar Minimum="0" Maximum="100"
                                   Value="{Binding Percent, TargetNullValue=0}"
                                   IsIndeterminate="{Binding Percent, Converter={x:Static ObjectConverters.IsNull}}"
                                   Foreground="{Binding State, Converter={x:Static v:Converters.TransferStateToBrush}}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Быстрые действия: diag/test run/заметка/close требуют ввода — ведут на «Действия». -->
            <TextBlock Classes="section" Text="Быстрые действия" Margin="0,4,0,0" />
            <WrapPanel ItemSpacing="6" LineSpacing="6">
              <Button Classes="sm" Content="diag" Command="{Binding Inspector.OpenTabCommand}" CommandParameter="6" />
              <Button Classes="sm" Content="test run" Command="{Binding Inspector.OpenTabCommand}" CommandParameter="6" />
              <Button Classes="sm" Command="{Binding Inspector.Actions.FreezeCommand}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Path Classes="icon sm" Data="{StaticResource Icon.Snow}" />
                  <TextBlock Text="freeze" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="sm" Content="заметка" Command="{Binding Inspector.OpenTabCommand}" CommandParameter="6" />
              <Button Classes="sm" Content="сенсоры" Command="{Binding Inspector.OpenTabCommand}" CommandParameter="3" />
              <Button Classes="sm danger" Content="close…" Command="{Binding Inspector.OpenTabCommand}" CommandParameter="6" />
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Вырубоны"><iv:RebootsTabView DataContext="{Binding Inspector.Reboots}" Margin="0,8,0,0" /></TabItem>
      <TabItem Header="Задачи"><iv:JobsTabView DataContext="{Binding Inspector.Jobs}" Margin="0,8,0,0" /></TabItem>
      <TabItem Header="Сенсоры"><iv:SensorsTabView DataContext="{Binding Inspector.Sensors}" Margin="0,8,0,0" /></TabItem>
      <TabItem Header="Журнал"><iv:JournalTabView DataContext="{Binding Inspector.Journal}" Margin="0,8,0,0" /></TabItem>
      <TabItem Header="Железо"><iv:HardwareTabView DataContext="{Binding Inspector.Hardware}" Margin="0,8,0,0" /></TabItem>
      <TabItem Header="Действия"><iv:ActionsView DataContext="{Binding Inspector.Actions}" Margin="0,8,0,0" /></TabItem>
    </TabControl>
  </Panel>
</UserControl>
