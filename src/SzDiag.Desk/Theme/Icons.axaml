  <StreamGeometry x:Key="Icon.Plus">M8,3.5 V12.5 M3.5,8 H12.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Check">M3.5,8.5 L6.5,11.5 L12.5,4.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.ChevRight">M6.5,4.5 L10,8 L6.5,11.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.ChevDown">M4.5,6.5 L8,10 L11.5,6.5</StreamGeometry>
