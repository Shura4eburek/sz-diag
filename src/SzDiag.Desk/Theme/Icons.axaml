<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Иконки 16×16 набора Shirabe (components/bundle.js), линия 1,2, цвет — Foreground.
       Круги и скруглённые прямоугольники SVG переведены в пути. bolt/snow/chat — своих в наборе
       нет, нарисованы в тех же правилах. Рисуются стилем Path.icon (Controls.axaml). -->
  <StreamGeometry x:Key="Icon.Min">M4,8.5 H12</StreamGeometry>
  <StreamGeometry x:Key="Icon.Max">M4,4 H12 V12 H4 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Restore">M3.5,5.5 H10.5 V12.5 H3.5 Z M5.5,5.5 V3.5 H12.5 V10.5 H10.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.X">M4.5,4.5 L11.5,11.5 M11.5,4.5 L4.5,11.5</StreamGeometry>
