<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Шкала шрифтов Shirabe: только 11–16px, цифры табличные (tnum) — числа в строках не пляшут. -->
  <Style Selector=":is(TextBlock).heading">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="LineHeight" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector=":is(TextBlock).title">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector=":is(TextBlock).body">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>
  <Style Selector=":is(TextBlock).body-medium">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>
  <Style Selector=":is(TextBlock).small">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>
  <Style Selector=":is(TextBlock).caption">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LineHeight" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>
  <Style Selector=":is(TextBlock).code">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="18" />
  </Style>
  <Style Selector=":is(TextBlock).code-small">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LineHeight" Value="16" />
  </Style>
  <Style Selector=":is(TextBlock).secondary">
    <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
  </Style>
  <Style Selector=":is(TextBlock).accent">
    <Setter Property="Foreground" Value="{StaticResource Accent.Text}" />
  </Style>
  <Style Selector=":is(TextBlock).error">
    <Setter Property="Foreground" Value="{StaticResource Status.Error}" />
  </Style>
  <Style Selector=":is(TextBlock).warning">
    <Setter Property="Foreground" Value="{StaticResource Status.Warning}" />
  </Style>
  <!-- Подпись секции: caption в регистре предложения, а не капс. -->
  <Style Selector=":is(TextBlock).section">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LineHeight" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
  </Style>
</Styles>
