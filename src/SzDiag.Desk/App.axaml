<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SzDiag.Desk.App"
             RequestedThemeVariant="Dark">
  <!-- Ресурсы раньше стилей: XAML заполняется по порядку, и StaticResource в Controls.axaml
       не нашёл бы токены, объявленные ниже. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://SzDiag.Desk/Theme/Tokens.axaml" />
        <ResourceInclude Source="avares://SzDiag.Desk/Theme/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <!-- Акцент — accent.default Shirabe, а не цвет Windows: у оператора системный акцент красный,
         и выделение, фокус и подчёркивание вкладки выглядели ошибкой (160176). -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#2f6ae0" RegionColor="#1e1f22" />
        <ColorPaletteResources x:Key="Light" Accent="#2f6ae0" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://SzDiag.Desk/Theme/Typography.axaml" />
    <StyleInclude Source="avares://SzDiag.Desk/Theme/Controls.axaml" />
  </Application.Styles>
</Application>
