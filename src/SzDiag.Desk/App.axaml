<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SzDiag.Desk.App"
             RequestedThemeVariant="Dark">
  <!-- Ресурсы раньше стилей: XAML заполняется по порядку, и StaticResource в Controls.axaml
       не нашёл бы токены, объявленные ниже. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://SzDiag.Desk/Theme/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://SzDiag.Desk/Theme/Controls.axaml" />
  </Application.Styles>
</Application>
